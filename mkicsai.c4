model {


    staff = staff 'Пользователи системы' {
        admin = staff 'Администраторы системы' {
            summary 'Анализ работы и настройка системы. Управление доступом к системе.'
        }
        operator = staff 'Операторы' {
            summary 'Анализ работы и сбоев оборудования, анализ качества распознавания прохождения подвижного состава.'
        }
    }
    mkicsai = container 'КИ-Ц САИ ПС.ИНП' {
        summary '''
            Концентратор информации центрального уровня предназначен для отслеживания 
            в реальном времени прохождений железнодорожного подвижного состава через контрольные пункты.
        '''
        description '''
            Концентратор информации центрального уровня предназначен для отслеживания 
            в реальном времени прохождений железнодорожного подвижного состава через 
            контрольные пункты. Сервис должен:
            - обеспечивать нагрузку более 100 000 проездов в сутки
            - расшифровку и анализ сообщений о проездах с учетом возможных ошибок и неправильной настройки оборудования
            - расшифровку и анализ сообщений о состояние специального оборудования
            - получения дополнительной информации из смежных сервисов РЖД
            - хеширования данных для ускорения работы
            - сохранения данных в БД для контроля работы сервиса и оборудования
            - передачу расшифрованных данных и данных об ошибках в смежные системы
            - сбор статистической информации для исправления ошибок
            - сбор данных для логирования ошибок и мониторинга нагрузки
            - поддержку клиентской части (SPA) для контроля и управления
        '''

        app = container 'КИ-Ц САИ ПС.ИНП (приложение)' {
            summary 'Приложение для управления работой системы, анализа работы оборудования и локомотивов, анализа качества распознавания прохождения подвижного состава.'
            spa = spa 'Web-приложение' {
                summary 'Клиентская часть (desktop)'
            }
            api = api 'API' {
                summary 'API для взаимодействия с сервисом.'
            }
            spa -> api 'Использует'

            admin -> spa 'Управление'
            operator -> spa 'Анализ и настройка'

            api -> secret_storage 'Аутентификация'
            api -> session_storage 'Сессии'
            api -> nsi_storage 'Чтение/запись НСИ'
            api -> operational_storage 'Анализ оперативных данных'
            api -> log_storage 'Анализ журналов'
            api -> external_storage 'Анализ данных внешних сервисов'
            api -> stat_storage 'Анализ статистики'

        }
        service = container 'КИ-Ц САИ ПС.ИНП (сервис)' {
            summary 'Управление рабочими процессами, логирование исключений, сбор данных для мониторинга.'
            aoc_worker = worker 'Чтение и первичная обработка BIN' {
                summary '''
                Чтение и первичная обработка входных сообщений BIN. 
                Запись в оперативные данные.
                '''
                -> bin 'Чтение'
                -> operational_storage 'Запись'
                -> ecma_worker 'Пересылка ошибки'
            }
            bin_worker = worker 'Обработка BIN' {
                summary '''
                Чтение BIN сообщений, расшифровка и анализ, формирование 2033.
                Сбор статистики для улучшения качества расшифровки.
                Запись результаты в оперативные данные.
                '''
                -> operational_storage 'Чтение/запись'
                -> ecma_worker 'Пересылка ошибки'
                -> external_storage 'Чтение'
                -> nsi_storage 'Чтение'
                -> stat_storage 'Чтение/Запись'
            }
            sts_worker = worker 'Чтение и обработка STS' {
                summary '''
                Чтение STS сообщений, расшифровка и анализ.
                Запись результаты в оперативные данные.
                '''
                -> sts 'Чтение'
                -> operational_storage 'Расшифровка/Запись'
                -> ecma_worker 'Пересылка ошибки'
            }
            m2033_worker = worker 'Формирование сообщений 2033' {
                summary '''
                Чтение 2033 из оперативных данных, запись в очередь 2033 для всех потребителей.
                '''
                -> operational_storage 'Чтение'
                -> m2033 'Запись'
                -> ecma_worker 'Пересылка ошибки'
            }
            ecma_worker = worker 'Анализ ошибок и отправка в ECMA' {
                summary '''
                Анализ оперативных данных на наличие ошибок, анализ и отправка в ECMA.
                Прием ошибок непосредственно от рабочих процессов, анализ и отправка в ECMA.
                Отправка в ECMA сообщений о прекращении снятия ошибки сформированной ранее.
                '''
                -> operational_storage 'Чтение/Анализ'
                -> ecma 'Запись'
            }
            esr_worker = worker 'Обновление НСИ' {
                summary '''
                Чтение НСИ из внешних сервисов и обновление данных в хранилище НСИ.
                '''
                -> nsi 'Чтение'
                -> nsi_storage 'Чтение'
            }
            esp_worker = worker 'Чтение и обработка данных из ЕС ПУЛ' {
                summary '''
                Анализ оперативных данных и обновление данных о локомотивах и самодвижущемся подвижном составе (СПС).
                '''
                -> esp 'Чтение'
                -> nsi_storage 'Запись'
            }
            aso_worker = worker 'Чтение и обработка данных из ЕМД ПП' {
                summary '''
                Анализ оперативных данных и обновление данных о предполагаемом времени прохождения и составе подвижного состава через остановочные пункты.
                '''
                -> aso 'Чтение'
                -> operational_storage 'Запись'
                -> ecma_worker 'Пересылка ошибки'
                -> stat_storage 'Чтение/Запись'
            }
            clone_worker = worker 'Создание и чистка оперативных таблиц' {
                summary '''
                Создание и очистка партиций оперативных таблиц.
                '''
                -> operational_storage 'Создание/очистка партиций'
                -> log_storage 'Создание/очистка партиций'
            }
        }
        app -> service 'Управление и отладка'
    }
    storage = storage 'Хранилище' {
        secret_storage = storage 'Секреты' {
            summary 'Хранилище данных для аутентификации и авторизации.'
        }
        session_storage = cash 'Сессий' {
            summary 'Хранилище данных для сессий пользователей.'
        }
        nsi_storage = storage 'НСИ' {
            summary 'Хранилище данных для нормативно справочной информации.'
        }
        stat_storage = storage 'Статистика' {
            summary 'Хранилище статистических для улучшения качества расшифровки прохождения подвижного состава.'
        }
        operational_storage = log_storage 'Оперативные данные' {
            summary 'Входящие сообщения, результаты расшифровки, результаты анализа ошибок, подготовленные сообщения 2033, сообщения ECMA.'
        }
        log_storage = log_storage 'Журналы и мониторинг' {
            summary 'Журналы работы рабочих процессов, журналы ошибок, журналы мониторинга.'
        }
        external_storage = cash_storage 'Данные внешних сервисов' {
            summary 'Данные внешних сервисов, полученные из ЕС ПУЛ, ЕМД ПП'
        }
    }
    external = external_service 'Внешние сервисы' {
        nsi = external_service 'Нормативно справочная информация' {
            summary 'Получение нормативно справочной информации о дорогах и станциях.'
        }
        esp = external_service 'ЕС ПУЛ' {
            summary 'Получение информации о локомотивах и самодвижущемся подвижном составе (СПС).'
        }
        aso = external_service 'ЕМД ПП' {
            summary 'Получение информации о предполагаемом времени прохождения и составе подвижного состава через остановочные пункты.'
        }
    }
    provider = external_service 'Поставщики данных' {
        source = external_service 'КИЛ' {
            summary 'Концентраторы информации линейного уровня.'
        }
        bin = external_queue 'Сообщения BIN' {
            summary 'Очередь входных сообщений о прохождении подвижного состава через контрольные пункты.'
        }
        sts = external_queue 'Сообщения STS' {
            summary 'Очередь входных сообщений о состоянии оборудования и локомотивов.'
        }
        source -> bin 'Запись'
        source -> sts 'Запись'
    }
    consumer = external_service 'Потребители данных' {
        target = external_service 'Системы и сервисы ОАО "РЖД"' {
            summary 'Потребители данных, системы и сервисы ОАО "РЖД".'
        }
        m2033 = external_queue 'Сообщения 2033' {
            summary 'Очередь выходных сообщений в формате 2033 о прохождении подвижного состава через контрольные пункты.'
        }
        ecma = external_queue 'Сообщения ECMA' {
            summary 'Очередь выходных сообщений в формате ECMA о сбоях и ошибках в работе оборудования.'
        }
        m2033 -> target 'Чтение и анализ'
        ecma -> target 'Чтение и анализ'
    }


}


views {

    view index {
        title 'КИ-Ц САИ ПС.ИНП (ландшафт)'
        description '''
            Концентратор информации центрального уровня предназначен для отслеживания 
            в реальном времени прохождений железнодорожного подвижного состава через 
            контрольные пункты.
        '''
        include app, service

        include admin, operator
        include nsi, esp, aso
        include source, bin, sts
        include target, m2033, ecma
        autoLayout LeftRight 120 100
    }

    view spa_view {
        title 'КИ-Ц САИ ПС.ИНП (SPA)'
        description '''
            Веб-приложение для управления работой системы, 
            анализа работы оборудования и локомотивов, 
            анализа качества распознавания прохождения подвижного состава.
        '''
        include spa
        include api
        include admin, operator
        include storage, secret_storage, session_storage, nsi_storage, stat_storage, operational_storage, log_storage, external_storage
        autoLayout TopBottom 75 50
    }

    view service_view {
        title 'КИ-Ц САИ ПС.ИНП (сервис)'
        description '''
            Сервис для обработки входных сообщений и формирования выходных сообщений.
            Запуск рабочих процессов по расписанию, логирование исключений, сбор данных для мониторинга.
        '''
        include service
        include aoc_worker, bin_worker, sts_worker, ecma_worker, esp_worker, aso_worker, m2033_worker, esr_worker, clone_worker
        include storage
        include bin, sts, m2033, ecma
        include external
        autoLayout TopBottom 90 60
    }

    view aoc_worker_view {
        title 'Чтение и первичная обработка BIN'
        description '''
            Рабочий процесс для чтения и первичной обработки входных сообщений BIN.
        '''
        include aoc_worker
        include bin
        include operational_storage
        include ecma_worker
        autoLayout LeftRight 70 50
    }
    view bin_worker_view {
        title 'Обработка BIN'
        description '''
            Рабочий процесс для обработки входных сообщений BIN.
        '''
        include bin_worker
        include operational_storage
        include ecma_worker
        include external_storage
        include nsi_storage
        include stat_storage
        autoLayout LeftRight 75 50
    }
    view sts_worker_view {
        title 'Чтение и обработка STS'
        description '''
            Рабочий процесс для чтения и обработки входных сообщений STS.
        '''
        include sts_worker
        include operational_storage
        include ecma_worker
        autoLayout LeftRight 70 50
    }
    view ecma_worker_view {
        title 'Анализ ошибок и отправка в ECMA'
        description '''
            Рабочий процесс для анализа ошибок и отправки в ECMA.
        '''
        include ecma_worker
        include operational_storage
        include ecma
        autoLayout LeftRight 70 50
    }
    view esr_worker_view {
        title 'Обновление НСИ'
        description '''
            Рабочий процесс для обновления нормативно справочной информации.
        '''
        include esr_worker
        include nsi_storage
        autoLayout TopBottom 60 40
    }
    view esp_worker_view {
        title 'Чтение и обработка данных из ЕС ПУЛ'
        description '''
            Рабочий процесс для чтения и обработки данных из ЕС ПУЛ.
        '''
        include esp_worker
        include esp
        include nsi_storage
        autoLayout LeftRight 70 50
    }
    view aso_worker_view {
        title 'Чтение и обработка данных из ЕМД ПП'
        description '''
            Рабочий процесс для чтения и обработки данных из ЕМД ПП.
        '''
        include aso_worker
        include aso
        include operational_storage
        include ecma_worker
        include stat_storage
        autoLayout LeftRight 70 50
    }
    view clone_worker_view {
        title 'Создание и чистка оперативных таблиц'
        description '''
            Рабочий процесс для создания и чистки оперативных таблиц.
        '''
        include clone_worker
        include operational_storage
        include log_storage
        autoLayout LeftRight 70 50
    }
}



